@model ITManager.Models.Equipo
@{
    ViewData["Title"] = $"Ficha Técnica: {Model.CodigoPatrimonial}";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h2 class="h3 fw-bold mb-0 text-white">@Model.Marca @Model.Modelo</h2>
            <span class="badge bg-primary font-monospace fs-6">@Model.CodigoPatrimonial</span>
        </div>
        <p class="text-secondary small mb-0">Ficha técnica detallada e historial de soporte del activo.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Volver al Inventario
        </a>
        @if (User.IsInRole("ADMINISTRADOR") || User.IsInRole("TECNICO"))
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning text-dark fw-semibold">
                <i class="bi bi-pencil me-1"></i> Editar
            </a>
            @if (Model.Estado != ITManager.Models.Enums.EstadoEquipo.DE_BAJA)
            {
                <form asp-action="DarDeBaja" asp-route-id="@Model.Id" method="post" class="d-inline" onsubmit="return confirm('¿Confirma dar de baja este equipo patrimonial?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger">
                        <i class="bi bi-trash me-1"></i> Dar de Baja
                    </button>
                </form>
            }
        }
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Información Principal -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-dark-subtle py-3 border-0">
                <h5 class="card-title fw-bold mb-0 text-white">
                    <i class="bi bi-info-circle me-2 text-primary"></i>Datos del Hardware
                </h5>
            </div>
            <div class="card-body">
                <ul class="list-group list-group-flush bg-transparent">
                    <li class="list-group-item bg-transparent text-light px-0 d-flex justify-content-between">
                        <span class="text-secondary">Código Patrimonial:</span>
                        <strong class="font-monospace text-info">@Model.CodigoPatrimonial</strong>
                    </li>
                    <li class="list-group-item bg-transparent text-light px-0 d-flex justify-content-between">
                        <span class="text-secondary">Número de Serie:</span>
                        <span class="font-monospace">@Model.NumeroSerie</span>
                    </li>
                    <li class="list-group-item bg-transparent text-light px-0 d-flex justify-content-between">
                        <span class="text-secondary">Categoría:</span>
                        <span>@(Model.Categoria?.Nombre ?? "Sin categoría")</span>
                    </li>
                    <li class="list-group-item bg-transparent text-light px-0 d-flex justify-content-between">
                        <span class="text-secondary">Ubicación Física:</span>
                        <span>@(Model.Ubicacion?.Nombre ?? "Sin asignar")</span>
                    </li>
                    <li class="list-group-item bg-transparent text-light px-0 d-flex justify-content-between">
                        <span class="text-secondary">Custodio Actual:</span>
                        <span>
                            @(Model.UsuarioCustodio != null ? $"{Model.UsuarioCustodio.Apellido}, {Model.UsuarioCustodio.Nombre}" : "Sin custodio (En pañol)")
                        </span>
                    </li>
                    <li class="list-group-item bg-transparent text-light px-0 d-flex justify-content-between align-items-center">
                        <span class="text-secondary">Estado Operativo:</span>
                        @switch (Model.Estado)
                        {
                            case ITManager.Models.Enums.EstadoEquipo.OPERATIVO:
                                <span class="badge bg-success-subtle text-success border border-success-subtle">OPERATIVO</span>
                                break;
                            case ITManager.Models.Enums.EstadoEquipo.EN_REPARACION:
                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle">EN REPARACIÓN</span>
                                break;
                            case ITManager.Models.Enums.EstadoEquipo.DE_BAJA:
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle">DE BAJA</span>
                                break;
                        }
                    </li>
                    <li class="list-group-item bg-transparent text-light px-0 d-flex justify-content-between">
                        <span class="text-secondary">Fecha de Alta:</span>
                        <span>@Model.FechaAlta.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                    </li>
                </ul>

                <div class="mt-4">
                    <a asp-controller="Tickets" asp-action="Create" asp-route-equipoId="@Model.Id" class="btn btn-outline-warning w-100">
                        <i class="bi bi-exclamation-octagon me-1"></i> Reportar Incidente sobre este Equipo
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Historial de Incidentes y Mantenimientos -->
    <div class="col-lg-8">
        <!-- Tickets Asociados -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-dark-subtle py-3 border-0 d-flex justify-content-between align-items-center">
                <h5 class="card-title fw-bold mb-0 text-white">
                    <i class="bi bi-ticket-detailed me-2 text-warning"></i>Historial de Tickets (@Model.Tickets.Count)
                </h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-dark text-secondary">
                            <tr>
                                <th>Código</th>
                                <th>Título</th>
                                <th>Solicitante</th>
                                <th>Prioridad</th>
                                <th>Estado</th>
                                <th>Fecha</th>
                                <th class="text-end">Ver</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Tickets.Any())
                            {
                                foreach (var t in Model.Tickets)
                                {
                                    <tr>
                                        <td class="font-monospace fw-semibold text-light">@t.Codigo</td>
                                        <td>@t.Titulo</td>
                                        <td class="small">@(t.UsuarioSolicitante?.Nombre ?? "N/A")</td>
                                        <td><span class="badge bg-secondary-subtle">@t.Prioridad</span></td>
                                        <td><span class="badge bg-info-subtle text-info">@t.Estado</span></td>
                                        <td class="small text-secondary">@t.FechaCreacion.ToLocalTime().ToString("dd/MM/yy")</td>
                                        <td class="text-end">
                                            <a asp-controller="Tickets" asp-action="Details" asp-route-id="@t.Id" class="btn btn-sm btn-outline-info">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-3 text-muted small">
                                        No registra incidentes reportados en la mesa de ayuda.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Mantenimientos Realizados -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-dark-subtle py-3 border-0 d-flex justify-content-between align-items-center">
                <h5 class="card-title fw-bold mb-0 text-white">
                    <i class="bi bi-tools me-2 text-success"></i>Órdenes de Mantenimiento (@Model.Mantenimientos.Count)
                </h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-dark text-secondary">
                            <tr>
                                <th>Fecha</th>
                                <th>Tipo</th>
                                <th>Técnico</th>
                                <th>Horas</th>
                                <th>Costo Repuestos</th>
                                <th>Diagnóstico</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Mantenimientos.Any())
                            {
                                foreach (var m in Model.Mantenimientos)
                                {
                                    <tr>
                                        <td class="small text-secondary">@m.Fecha.ToLocalTime().ToString("dd/MM/yyyy")</td>
                                        <td><span class="badge bg-success-subtle text-success">@m.Tipo</span></td>
                                        <td class="small">@(m.Tecnico?.Apellido ?? "N/A"), @(m.Tecnico?.Nombre ?? "")</td>
                                        <td>@m.HorasTrabajo hs</td>
                                        <td class="font-monospace">$@m.CostoTotalRepuestos</td>
                                        <td class="small text-truncate" style="max-width: 200px;">@m.Diagnostico</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-3 text-muted small">
                                        No se han ejecutado intervenciones técnicas en este equipo.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
