@model ITManager.ViewModels.EquipoIndexViewModel
@{
    ViewData["Title"] = "Inventario de Equipos";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="h3 fw-bold mb-1 text-white">
            <i class="bi bi-pc-display me-2 text-primary"></i>Inventario de Equipos
        </h2>
        <p class="text-secondary small mb-0">Gestión de activos de hardware, asignación de custodios y estados.</p>
    </div>
    @if (User.IsInRole("ADMINISTRADOR") || User.IsInRole("TECNICO"))
    {
        <a asp-action="Create" class="btn btn-primary px-3 shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Nuevo Equipo
        </a>
    }
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["WarningMessage"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["WarningMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Barra de Filtros -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-dark-subtle border-secondary-subtle text-secondary">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Buscar por código, serie, marca o modelo..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="categoriaId" asp-items="ViewBag.Categorias" class="form-select">
                    <option value="">-- Todas las Categorías --</option>
                </select>
            </div>
            <div class="col-md-3">
                <select name="estado" class="form-select">
                    <option value="">-- Todos los Estados --</option>
                    @foreach (var est in (ITManager.Models.Enums.EstadoEquipo[])ViewBag.Estados)
                    {
                        <!option value="@est" @(Model.Estado == est ? "selected" : "")>@est</!option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-funnel"></i> Filtrar
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary" title="Limpiar Filtros">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Tabla de Equipos -->
<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark text-secondary">
                <tr>
                    <th scope="col">Cód. Patrimonial</th>
                    <th scope="col">Equipo</th>
                    <th scope="col">Categoría</th>
                    <th scope="col">Ubicación</th>
                    <th scope="col">Custodio</th>
                    <th scope="col">Estado</th>
                    <th scope="col" class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Equipos.Any())
                {
                    @foreach (var item in Model.Equipos)
                    {
                        <tr>
                            <td class="fw-bold text-light font-monospace">@item.CodigoPatrimonial</td>
                            <td>
                                <div><span class="fw-semibold">@item.Marca</span> @item.Modelo</div>
                                <small class="text-secondary">S/N: @item.NumeroSerie</small>
                            </td>
                            <td>
                                <span class="badge bg-secondary-subtle text-secondary-emphasis">
                                    @(item.Categoria?.Nombre ?? "N/A")
                                </span>
                            </td>
                            <td>
                                <i class="bi bi-geo-alt text-secondary me-1"></i>
                                @(item.Ubicacion?.Nombre ?? "Sin asignar")
                            </td>
                            <td>
                                @if (item.UsuarioCustodio != null)
                                {
                                    <span class="text-info small">
                                        <i class="bi bi-person me-1"></i>@item.UsuarioCustodio.Apellido, @item.UsuarioCustodio.Nombre
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted small">Disponible en pañol</span>
                                }
                            </td>
                            <td>
                                @switch (item.Estado)
                                {
                                    case ITManager.Models.Enums.EstadoEquipo.OPERATIVO:
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">OPERATIVO</span>
                                        break;
                                    case ITManager.Models.Enums.EstadoEquipo.EN_REPARACION:
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle">EN REPARACIÓN</span>
                                        break;
                                    case ITManager.Models.Enums.EstadoEquipo.DE_BAJA:
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">DE BAJA</span>
                                        break;
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info" title="Ver Ficha Técnica">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (User.IsInRole("ADMINISTRADOR") || User.IsInRole("TECNICO"))
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning" title="Editar">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                            No se encontraron equipos que coincidan con los filtros aplicados.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Paginador Server-side -->
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-transparent border-top border-secondary-subtle d-flex justify-content-between align-items-center flex-wrap py-3">
            <span class="text-secondary small">
                Mostrando página @Model.Page de @Model.TotalPages (Total: @Model.TotalCount equipos)
            </span>
            <nav aria-label="Navegación de páginas">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-page="@(Model.Page - 1)"
                           asp-route-searchTerm="@Model.SearchTerm"
                           asp-route-categoriaId="@Model.CategoriaId"
                           asp-route-estado="@Model.Estado">Anterior</a>
                    </li>
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(Model.Page == i ? "active" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-page="@i"
                               asp-route-searchTerm="@Model.SearchTerm"
                               asp-route-categoriaId="@Model.CategoriaId"
                               asp-route-estado="@Model.Estado">@i</a>
                        </li>
                    }
                    <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-page="@(Model.Page + 1)"
                           asp-route-searchTerm="@Model.SearchTerm"
                           asp-route-categoriaId="@Model.CategoriaId"
                           asp-route-estado="@Model.Estado">Siguiente</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>

