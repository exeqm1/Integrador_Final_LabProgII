@model ITManager.ViewModels.EquipoFormViewModel
@{
    ViewData["Title"] = "Editar Equipo";
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <div class="card border-0 shadow-lg">
            <div class="card-header bg-dark-subtle py-3 border-0">
                <div class="d-flex align-items-center justify-content-between">
                    <h4 class="h5 fw-bold mb-0 text-white">
                        <i class="bi bi-pencil-square me-2 text-warning"></i>
                        Editar Equipo: @Model.CodigoPatrimonial
                    </h4>
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Volver
                    </a>
                </div>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-4" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="CodigoPatrimonial" class="form-label fw-semibold small text-light"></label>
                            <input asp-for="CodigoPatrimonial" class="form-control" />
                            <span asp-validation-for="CodigoPatrimonial" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="NumeroSerie" class="form-label fw-semibold small text-light"></label>
                            <input asp-for="NumeroSerie" class="form-control" />
                            <span asp-validation-for="NumeroSerie" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Marca" class="form-label fw-semibold small text-light"></label>
                            <input asp-for="Marca" class="form-control" />
                            <span asp-validation-for="Marca" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Modelo" class="form-label fw-semibold small text-light"></label>
                            <input asp-for="Modelo" class="form-control" />
                            <span asp-validation-for="Modelo" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CategoriaId" class="form-label fw-semibold small text-light"></label>
                            <select asp-for="CategoriaId" asp-items="ViewBag.Categorias" class="form-select">
                                <option value="">-- Seleccionar Categoría --</option>
                            </select>
                            <span asp-validation-for="CategoriaId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="UbicacionId" class="form-label fw-semibold small text-light"></label>
                            <select asp-for="UbicacionId" asp-items="ViewBag.Ubicaciones" class="form-select">
                                <option value="">-- Seleccionar Ubicación --</option>
                            </select>
                            <span asp-validation-for="UbicacionId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-8">
                            <label asp-for="UsuarioCustodioId" class="form-label fw-semibold small text-light"></label>
                            <select asp-for="UsuarioCustodioId" asp-items="ViewBag.Usuarios" class="form-select">
                                <option value="">-- Sin Custodio Asignado (En pañol) --</option>
                            </select>
                            <span asp-validation-for="UsuarioCustodioId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Estado" class="form-label fw-semibold small text-light"></label>
                            <select asp-for="Estado" class="form-select">
                                @foreach (var est in (ITManager.Models.Enums.EstadoEquipo[])ViewBag.Estados)
                                {
                                    <!option value="@est" @(Model.Estado == est ? "selected" : "")>@est</!option>
                                }
                            </select>
                            <span asp-validation-for="Estado" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top border-secondary-subtle">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancelar</a>
                        <button type="submit" class="btn btn-warning px-4 fw-semibold text-dark">
                            <i class="bi bi-check2-circle me-1"></i> Actualizar Cambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

