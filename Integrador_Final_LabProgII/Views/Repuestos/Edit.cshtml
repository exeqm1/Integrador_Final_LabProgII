@model ITManager.ViewModels.RepuestoFormViewModel
@{
    ViewData["Title"] = "Editar Repuesto";
}

<div class="row justify-content-center">
    <div class="col-lg-7 col-xl-6">
        <div class="card border-0 shadow-lg">
            <div class="card-header bg-dark-subtle py-3 border-0">
                <div class="d-flex align-items-center justify-content-between">
                    <h4 class="h5 fw-bold mb-0 text-white">
                        <i class="bi bi-pencil-square text-warning me-2"></i>
                        Editar Repuesto: @Model.Nombre
                    </h4>
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Volver
                    </a>
                </div>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-4"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Codigo" class="form-label small fw-semibold text-light"></label>
                            <input asp-for="Codigo" class="form-control font-monospace" />
                            <span asp-validation-for="Codigo" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CostoUnitario" class="form-label small fw-semibold text-light"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-dark-subtle text-secondary">$</span>
                                <input asp-for="CostoUnitario" type="number" step="0.01" class="form-control" />
                            </div>
                            <span asp-validation-for="CostoUnitario" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Nombre" class="form-label small fw-semibold text-light"></label>
                            <input asp-for="Nombre" class="form-control" />
                            <span asp-validation-for="Nombre" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Descripcion" class="form-label small fw-semibold text-light"></label>
                            <textarea asp-for="Descripcion" rows="2" class="form-control"></textarea>
                            <span asp-validation-for="Descripcion" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="StockActual" class="form-label small fw-semibold text-light"></label>
                            <input asp-for="StockActual" type="number" class="form-control" />
                            <span asp-validation-for="StockActual" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="StockMinimo" class="form-label small fw-semibold text-light"></label>
                            <input asp-for="StockMinimo" type="number" class="form-control" />
                            <span asp-validation-for="StockMinimo" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top border-secondary-subtle">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancelar</a>
                        <button type="submit" class="btn btn-warning text-dark px-4 fw-semibold">
                            <i class="bi bi-save me-1"></i> Actualizar Repuesto
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

