@model IEnumerable<ITManager.Models.Repuesto>
@{
    ViewData["Title"] = "Pañol de Repuestos";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="h3 fw-bold mb-1 text-white">
            <i class="bi bi-boxes me-2 text-info"></i>Pañol de Repuestos e Insumos
        </h2>
        <p class="text-secondary small mb-0">Gestión de inventario físico de piezas, monitoreo de stock crítico y reposición.</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-info text-dark fw-semibold px-3 shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Nuevo Repuesto
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark text-secondary">
                <tr>
                    <th>Código</th>
                    <th>Repuesto / Insumo</th>
                    <th>Descripción</th>
                    <th class="text-center">Stock Actual</th>
                    <th class="text-center">Stock Mínimo</th>
                    <th class="text-end">Costo Unitario</th>
                    <th class="text-center">Estado Stock</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        var esCritico = item.StockActual <= item.StockMinimo;
                        var sinStock = item.StockActual == 0;
                        <tr>
                            <td class="font-monospace fw-bold text-light">@item.Codigo</td>
                            <td class="fw-semibold">@item.Nombre</td>
                            <td class="small text-secondary text-truncate" style="max-width: 200px;">@item.Descripcion</td>
                            <td class="text-center font-monospace fs-6 fw-bold @(sinStock ? "text-danger" : esCritico ? "text-warning" : "text-light")">
                                @item.StockActual
                            </td>
                            <td class="text-center font-monospace text-secondary">@item.StockMinimo</td>
                            <td class="text-end font-monospace text-success fw-semibold">$@item.CostoUnitario</td>
                            <td class="text-center">
                                @if (sinStock)
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">AGOTADO</span>
                                }
                                else if (esCritico)
                                {
                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle">STOCK CRÍTICO</span>
                                }
                                else
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">NORMAL</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1">
                                    <!-- Botón modal reponer -->
                                    <button type="button" class="btn btn-sm btn-outline-success" data-bs-toggle="modal" data-bs-target="#modalReponer_@item.Id" title="Reponer Stock">
                                        <i class="bi bi-box-arrow-in-down"></i> Reponer
                                    </button>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                </div>

                                <!-- Modal Reponer Stock -->
                                <div class="modal fade" id="modalReponer_@item.Id" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered modal-sm text-start">
                                        <div class="modal-content bg-dark border-secondary">
                                            <form asp-action="ReponerStock" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <div class="modal-header border-secondary py-2">
                                                    <h6 class="modal-title text-white">Reponer: @item.Nombre</h6>
                                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body py-3">
                                                    <label class="form-label small text-secondary">Cantidad a ingresar al pañol:</label>
                                                    <input type="number" name="cantidad" class="form-control" min="1" value="5" required />
                                                </div>
                                                <div class="modal-footer border-secondary py-2">
                                                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                                                    <button type="submit" class="btn btn-sm btn-success">Confirmar Ingreso</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">
                            No hay repuestos registrados en el pañol.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
