<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - IT Manager</title>
    <!-- Bootstrap 5.3 & Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        :root {
            --sidebar-width: 260px;
        }
        body {
            background-color: #0f172a;
            color: #e2e8f0;
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        .navbar-custom {
            background: rgba(15, 23, 42, 0.95);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        }
        .nav-link {
            color: #94a3b8;
            transition: color 0.2s ease, background-color 0.2s ease;
            font-weight: 500;
        }
        .nav-link:hover, .nav-link.active {
            color: #38bdf8 !important;
        }
        .user-avatar-badge {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid #38bdf8;
        }
        .dropdown-menu-dark {
            background-color: #1e293b;
            border-color: rgba(255, 255, 255, 0.1);
        }
        .card {
            background-color: #1e293b;
            border: 1px solid rgba(255, 255, 255, 0.08);
            color: #f1f5f9;
        }
        footer {
            margin-top: auto;
            border-top: 1px solid rgba(255, 255, 255, 0.08);
            background-color: #0b1120;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-custom sticky-top py-2">
            <div class="container-fluid px-3 px-md-4">
                <a class="navbar-brand d-flex align-items-center gap-2 fw-bold text-white me-4" asp-controller="Home" asp-action="Index">
                    <span class="d-inline-flex align-items-center justify-content-center bg-primary rounded-3 text-white p-2" style="width: 32px; height: 32px;">
                        <i class="bi bi-hdd-network fs-6"></i>
                    </span>
                    <span>IT Manager</span>
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-1">
                            <li class="nav-item">
                                <a class="nav-link px-3 rounded-2" asp-controller="Home" asp-action="Index">
                                    <i class="bi bi-speedometer2 me-1"></i> Dashboard
                                </a>
                            </li>

                            @* VISTAS ADMINISTRADOR *@
                            @if (User.IsInRole("ADMINISTRADOR"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle px-3 rounded-2" href="#" id="adminMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-shield-lock me-1"></i> Gestión
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-dark shadow" aria-labelledby="adminMenu">
                                        <li><h6 class="dropdown-header text-uppercase text-muted">Activos & Soporte</h6></li>
                                        <li><a class="dropdown-item" href="/Equipos"><i class="bi bi-pc-display me-2"></i> Equipos</a></li>
                                        <li><a class="dropdown-item" href="/Tickets"><i class="bi bi-ticket-detailed me-2"></i> Tickets</a></li>
                                        <li><a class="dropdown-item" href="/Mantenimientos"><i class="bi bi-tools me-2"></i> Mantenimientos</a></li>
                                        <li><a class="dropdown-item" href="/Repuestos"><i class="bi bi-boxes me-2"></i> Repuestos e Inventario</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><h6 class="dropdown-header text-uppercase text-muted">Configuración</h6></li>
                                        <li><a class="dropdown-item" href="/Usuarios"><i class="bi bi-people me-2"></i> Usuarios</a></li>
                                        <li><a class="dropdown-item" href="/Categorias"><i class="bi bi-tags me-2"></i> Categorías</a></li>
                                        <li><a class="dropdown-item" href="/Ubicaciones"><i class="bi bi-geo-alt me-2"></i> Ubicaciones</a></li>
                                    </ul>
                                </li>
                            }

                            @* VISTAS TECNICO *@
                            @if (User.IsInRole("TECNICO"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link px-3 rounded-2" href="/Tickets/Asignados">
                                        <i class="bi bi-card-checklist me-1"></i> Tickets Asignados
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link px-3 rounded-2" href="/Mantenimientos">
                                        <i class="bi bi-tools me-1"></i> Registro Mantenimientos
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link px-3 rounded-2" href="/Equipos">
                                        <i class="bi bi-pc-display me-1"></i> Inventario Equipos
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link px-3 rounded-2" href="/Repuestos">
                                        <i class="bi bi-boxes me-1"></i> Repuestos
                                    </a>
                                </li>
                            }

                            @* VISTAS EMPLEADO *@
                            @if (User.IsInRole("EMPLEADO"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link px-3 rounded-2" href="/Tickets/MisTickets">
                                        <i class="bi bi-person-lines-fill me-1"></i> Mis Tickets
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link px-3 rounded-2" href="/Tickets/Crear">
                                        <i class="bi bi-plus-circle me-1 text-info"></i> Reportar Incidente
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link px-3 rounded-2" href="/Equipos">
                                        <i class="bi bi-laptop me-1 text-warning"></i> Mis Equipos Asignados
                                    </a>
                                </li>
                            }
                        </ul>

                        <div class="d-flex align-items-center gap-3 ms-auto">
                            <div class="dropdown">
                                <a href="#" class="d-flex align-items-center text-white text-decoration-none dropdown-toggle gap-2" id="userMenu" data-bs-toggle="dropdown" aria-expanded="false">
                                    <img src="@(User.FindFirst("AvatarUrl")?.Value ?? "/img/avatars/default.png")"
                                         onerror="this.src='https://ui-avatars.com/api/?name=@(Uri.EscapeDataString(User.Identity?.Name ?? "User"))&background=0d6efd&color=fff'"
                                         alt="Avatar" class="user-avatar-badge" />
                                    <div class="d-none d-sm-block text-start leading-tight">
                                        <div class="fw-semibold small">@User.Identity?.Name</div>
                                        <span class="badge bg-primary-subtle text-primary-emphasis border border-primary-subtle" style="font-size: 0.65rem;">
                                            @(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value)
                                        </span>
                                    </div>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end shadow" aria-labelledby="userMenu">
                                    <li><h6 class="dropdown-header">@User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value</h6></li>
                                    <li><a class="dropdown-item" href="/Home/Index"><i class="bi bi-speedometer2 me-2"></i> Panel de Inicio</a></li>
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile"><i class="bi bi-person-badge me-2 text-info"></i> Mi Perfil y Avatar</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger">
                                                <i class="bi bi-box-arrow-right me-2"></i> Cerrar Sesión
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="ms-auto">
                            <a class="btn btn-primary btn-sm px-3 fw-semibold" asp-controller="Account" asp-action="Login">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar Sesión
                            </a>
                        </div>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-3 px-md-4 py-4 flex-grow-1">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="py-3 text-secondary small">
        <div class="container-fluid px-4 d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
            <div>
                &copy; @DateTime.Now.Year <strong>IT Manager</strong> - Laboratorio de Programación II
            </div>
            <div>
                <span class="badge bg-secondary-subtle text-secondary-emphasis">.NET 10 &amp; MySQL</span>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
