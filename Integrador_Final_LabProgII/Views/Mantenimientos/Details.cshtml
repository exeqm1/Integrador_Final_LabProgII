@model ITManager.Models.Mantenimiento
@{
    ViewData["Title"] = $"Remito Técnico #{Model.Id}";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h2 class="h3 fw-bold mb-0 text-white">Orden de Mantenimiento #@Model.Id</h2>
            <span class="badge @(Model.Tipo == ITManager.Models.Enums.TipoMantenimiento.PREVENTIVO ? "bg-info-subtle text-info" : "bg-warning-subtle text-warning") border fs-6">
                @Model.Tipo
            </span>
        </div>
        <p class="text-secondary small mb-0">
            Ejecutado por <strong class="text-light">@(Model.Tecnico?.Apellido), @(Model.Tecnico?.Nombre)</strong>
            el @Model.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
        </p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Volver a Órdenes
        </a>
        <button type="button" class="btn btn-primary" onclick="window.print()">
            <i class="bi bi-printer me-1"></i> Imprimir Remito
        </button>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-4">
    <!-- Remito / Detalles Técnicos -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-dark-subtle py-3 border-0">
                <h5 class="card-title fw-bold mb-0 text-white">
                    <i class="bi bi-file-earmark-medical me-2 text-primary"></i>Informe Técnico de Intervención
                </h5>
            </div>
            <div class="card-body">
                <div class="mb-4">
                    <h6 class="text-secondary small fw-bold text-uppercase">Diagnóstico Técnico</h6>
                    <p class="text-light">@Model.Diagnostico</p>
                </div>
                <div class="mb-4">
                    <h6 class="text-secondary small fw-bold text-uppercase">Tareas Realizadas</h6>
                    <p class="text-light" style="white-space: pre-line;">@Model.TareasRealizadas</p>
                </div>
                <div class="row g-3 p-3 rounded-3 bg-dark-subtle border border-secondary-subtle">
                    <div class="col-sm-6">
                        <span class="text-secondary small d-block">Horas de Mano de Obra:</span>
                        <strong class="fs-5 text-light">@Model.HorasTrabajo hs</strong>
                    </div>
                    <div class="col-sm-6 text-sm-end">
                        <span class="text-secondary small d-block">Costo Insumos / Repuestos:</span>
                        <strong class="fs-5 text-success font-monospace">$@Model.CostoTotalRepuestos</strong>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tabla de Repuestos Consumidos con Costo Histórico -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-dark-subtle py-3 border-0 d-flex justify-content-between align-items-center">
                <h5 class="card-title fw-bold mb-0 text-white">
                    <i class="bi bi-boxes me-2 text-info"></i>Repuestos Utilizados (@Model.Detalles.Count)
                </h5>
                <span class="badge bg-secondary-subtle text-secondary small">Costo Histórico Congelado</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-dark text-secondary">
                            <tr>
                                <th>Código</th>
                                <th>Repuesto</th>
                                <th class="text-center">Cantidad</th>
                                <th class="text-end">Costo Unit. (Histórico)</th>
                                <th class="text-end">Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Detalles.Any())
                            {
                                @foreach (var d in Model.Detalles)
                                {
                                    var subtotal = d.Cantidad * d.CostoHistorico;
                                    <tr>
                                        <td class="font-monospace fw-semibold text-light">@(d.Repuesto?.Codigo ?? "N/A")</td>
                                        <td>@(d.Repuesto?.Nombre ?? "Repuesto descontinuado")</td>
                                        <td class="text-center font-monospace">@d.Cantidad</td>
                                        <td class="text-end font-monospace">$@d.CostoHistorico</td>
                                        <td class="text-end font-monospace text-success fw-bold">$@subtotal</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-3 text-muted small">
                                        No se consumieron piezas ni repuestos en este mantenimiento (solo mano de obra).
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="fw-bold bg-dark-subtle border-top border-secondary">
                                <td colspan="4" class="text-end text-light">TOTAL CONSUMIDO EN REPUESTOS:</td>
                                <td class="text-end text-success font-monospace fs-6">$@Model.CostoTotalRepuestos</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>

        <!-- Archivos Adjuntos / Evidencia -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-dark-subtle py-3 border-0 d-flex justify-content-between align-items-center">
                <h5 class="card-title fw-bold mb-0 text-white">
                    <i class="bi bi-paperclip me-2 text-warning"></i>Archivos Adjuntos &amp; Evidencia (@Model.Adjuntos.Count)
                </h5>
            </div>
            <div class="card-body">
                @if (Model.Adjuntos.Any())
                {
                    <div class="list-group list-group-flush mb-4">
                        @foreach (var adj in Model.Adjuntos)
                        {
                            <div class="list-group-item bg-transparent text-light px-0 d-flex justify-content-between align-items-center">
                                <div>
                                    <i class="bi bi-file-earmark me-2 text-info"></i>
                                    <a href="@adj.RutaArchivo" target="_blank" class="text-decoration-none text-light fw-semibold">
                                        @adj.NombreOriginal
                                    </a>
                                    <small class="text-secondary d-block">Subido el @adj.FechaSubida.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>
                                </div>
                                <div>
                                    <a asp-controller="Adjuntos" asp-action="Delete" asp-route-id="@adj.Id" class="btn btn-sm btn-outline-danger" onclick="return confirm('¿Confirma eliminar este archivo adjunto?');">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-3 text-muted small mb-3">
                        No hay archivos ni fotografías adjuntas a esta orden.
                    </div>
                }

                <!-- Subir Nuevo Archivo -->
                <form asp-controller="Adjuntos" asp-action="Upload" method="post" enctype="multipart/form-data" class="row g-2 align-items-center">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="mantenimientoId" value="@Model.Id" />
                    <div class="col-sm-8">
                        <input type="file" name="archivo" class="form-control form-control-sm" accept=".jpg,.jpeg,.png,.pdf" required />
                    </div>
                    <div class="col-sm-4">
                        <button type="submit" class="btn btn-sm btn-outline-warning w-100 fw-semibold">
                            <i class="bi bi-upload me-1"></i> Subir Archivo
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Columna Derecha: Equipo y Ticket Asociados -->
    <div class="col-lg-4">
        <!-- Equipo -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-dark-subtle py-3 border-0">
                <h5 class="card-title fw-bold mb-0 text-white">
                    <i class="bi bi-pc-display me-2 text-primary"></i>Activo Intervenido
                </h5>
            </div>
            <div class="card-body">
                @if (Model.Equipo != null)
                {
                    <ul class="list-group list-group-flush bg-transparent">
                        <li class="list-group-item bg-transparent text-light px-0 d-flex justify-content-between">
                            <span class="text-secondary">Código Patrimonial:</span>
                            <strong class="font-monospace text-info">@Model.Equipo.CodigoPatrimonial</strong>
                        </li>
                        <li class="list-group-item bg-transparent text-light px-0 d-flex justify-content-between">
                            <span class="text-secondary">Equipo:</span>
                            <span>@Model.Equipo.Marca @Model.Equipo.Modelo</span>
                        </li>
                        <li class="list-group-item bg-transparent text-light px-0 d-flex justify-content-between">
                            <span class="text-secondary">Categoría:</span>
                            <span>@(Model.Equipo.Categoria?.Nombre ?? "N/A")</span>
                        </li>
                        <li class="list-group-item bg-transparent text-light px-0 d-flex justify-content-between">
                            <span class="text-secondary">Ubicación:</span>
                            <span>@(Model.Equipo.Ubicacion?.Nombre ?? "N/A")</span>
                        </li>
                    </ul>
                    <a asp-controller="Equipos" asp-action="Details" asp-route-id="@Model.Equipo.Id" class="btn btn-sm btn-outline-info w-100 mt-3">
                        <i class="bi bi-eye me-1"></i> Ver Ficha del Equipo
                    </a>
                }
            </div>
        </div>

        <!-- Ticket Vinculado -->
        @if (Model.Ticket != null)
        {
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-dark-subtle py-3 border-0">
                    <h5 class="card-title fw-bold mb-0 text-white">
                        <i class="bi bi-ticket-detailed me-2 text-warning"></i>Incidente de Origen
                    </h5>
                </div>
                <div class="card-body">
                    <div class="mb-2">
                        <span class="badge bg-warning text-dark font-monospace">@Model.Ticket.Codigo</span>
                        <span class="badge bg-success-subtle text-success ms-1">@Model.Ticket.Estado</span>
                    </div>
                    <h6 class="fw-bold text-light">@Model.Ticket.Titulo</h6>
                    <p class="text-secondary small mb-3">@Model.Ticket.Descripcion</p>
                    <a asp-controller="Tickets" asp-action="Details" asp-route-id="@Model.Ticket.Id" class="btn btn-sm btn-outline-warning w-100">
                        <i class="bi bi-eye me-1"></i> Abrir Ticket de Soporte
                    </a>
                </div>
            </div>
        }
    </div>
</div>
