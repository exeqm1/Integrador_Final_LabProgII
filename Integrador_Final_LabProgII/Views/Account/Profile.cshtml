@model ITManager.ViewModels.UserProfileViewModel
@{
    ViewData["Title"] = "Mi Perfil";
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <div class="card border-0 shadow-lg">
            <div class="card-header bg-dark-subtle py-3 border-0">
                <div class="d-flex align-items-center justify-content-between">
                    <h4 class="h5 fw-bold mb-0 text-white">
                        <i class="bi bi-person-badge me-2 text-info"></i> Mi Perfil y Avatar
                    </h4>
                    <span class="badge bg-primary px-3 py-2">@Model.Rol</span>
                </div>
            </div>
            <div class="card-body p-4">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <form asp-action="Profile" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-4" role="alert"></div>

                    <!-- Sección Avatar -->
                    <div class="card bg-body-tertiary border-0 mb-4 p-3">
                        <div class="row align-items-center">
                            <div class="col-auto text-center">
                                <img src="@Model.AvatarUrl" alt="Avatar" class="rounded-circle shadow border border-2 border-primary" style="width: 90px; height: 90px; object-fit: cover;" onerror="this.src='/img/avatars/default.png'" />
                            </div>
                            <div class="col">
                                <label asp-for="AvatarFile" class="form-label fw-bold text-light small"></label>
                                <input asp-for="AvatarFile" class="form-control" type="file" accept="image/*" />
                                <span asp-validation-for="AvatarFile" class="text-danger small"></span>
                                <div class="form-text text-secondary small">Formatos permitidos: JPG, PNG, GIF, WebP. Tamaño máximo: 2 MB.</div>
                            </div>
                        </div>
                    </div>

                    <!-- Datos del Usuario (Lectura / Info) -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-secondary">Nombre y Apellido</label>
                            <input type="text" class="form-control bg-dark text-white border-secondary" value="@Model.Nombre @Model.Apellido" disabled />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-secondary">Correo Electrónico</label>
                            <input type="text" class="form-control bg-dark text-white border-secondary" value="@Model.Email" disabled />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-secondary">Rol Asignado</label>
                            <input type="text" class="form-control bg-dark text-white border-secondary" value="@Model.Rol" disabled />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-secondary">Sede / Ubicación Física</label>
                            <input type="text" class="form-control bg-dark text-white border-secondary" value="@Model.UbicacionNombre" disabled />
                        </div>
                    </div>

                    <hr class="border-secondary my-4" />

                    <!-- Cambio de Contraseña Opcional -->
                    <h5 class="h6 fw-bold text-warning mb-3">
                        <i class="bi bi-shield-lock me-1"></i> Cambiar Contraseña (Opcional)
                    </h5>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="NuevaPassword" class="form-label fw-semibold small text-light"></label>
                            <input asp-for="NuevaPassword" class="form-control" placeholder="Dejar en blanco para no cambiarla" />
                            <span asp-validation-for="NuevaPassword" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ConfirmarPassword" class="form-label fw-semibold small text-light"></label>
                            <input asp-for="ConfirmarPassword" class="form-control" placeholder="Repetir nueva contraseña" />
                            <span asp-validation-for="ConfirmarPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                            Cancelar
                        </a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-save me-1"></i> Guardar Cambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
