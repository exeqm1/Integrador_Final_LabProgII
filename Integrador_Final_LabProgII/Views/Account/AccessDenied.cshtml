@{
    ViewData["Title"] = "Acceso Denegado";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-lg bg-dark text-light p-4 rounded-4">
                <div class="card-body">
                    <div class="mb-3 text-warning">
                        <i class="bi bi-shield-x fs-1"></i>
                    </div>
                    <h2 class="h4 fw-bold mb-2">Acceso No Autorizado</h2>
                    <p class="text-secondary mb-4">
                        Tu cuenta actual no posee los privilegios necesarios para ingresar a este módulo del sistema.
                    </p>
                    <div class="d-flex justify-content-center gap-2">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-light px-4">
                            <i class="bi bi-house me-1"></i> Ir al Inicio
                        </a>
                        <a asp-controller="Account" asp-action="Logout" class="btn btn-danger px-4">
                            <i class="bi bi-box-arrow-right me-1"></i> Cambiar Cuenta
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
