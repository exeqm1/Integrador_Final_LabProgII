@model ITManager.ViewModels.TicketIndexViewModel
@{
    ViewData["Title"] = Model.SoloMisTickets ? "Mis Tickets" : "Tickets";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h1 class="h5 fw-semibold mb-0 text-white">@ViewData["Title"]</h1>
        <span class="text-secondary small">Seguimiento de incidentes técnicos</span>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary">
            Nuevo Ticket
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Filtros -->
<div class="card mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="@(Model.SoloMisTickets ? "MisTickets" : "Index")" class="row g-2 align-items-center">
            <div class="col-md-4">
                <select name="estado" class="form-select">
                    <option value="">-- Todos los Estados --</option>
                    @foreach (var est in (ITManager.Models.Enums.EstadoTicket[])ViewBag.Estados)
                    {
                        <!option value="@est" @(Model.Estado == est ? "selected" : "")>@est</!option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <select name="prioridad" class="form-select">
                    <option value="">-- Todas las Prioridades --</option>
                    @foreach (var prio in (ITManager.Models.Enums.PrioridadTicket[])ViewBag.Prioridades)
                    {
                        <!option value="@prio" @(Model.Prioridad == prio ? "selected" : "")>@prio</!option>
                    }
                </select>
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-outline-secondary w-100">
                    Filtrar
                </button>
                <a asp-action="@(Model.SoloMisTickets ? "MisTickets" : "Index")" class="btn btn-outline-secondary" title="Limpiar">
                    Limpiar
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Tabla de Tickets -->
<div class="card">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th scope="col" style="width: 120px;">Código</th>
                    <th scope="col">Título</th>
                    <th scope="col">Equipo</th>
                    <th scope="col">Solicitante</th>
                    <th scope="col">Técnico</th>
                    <th scope="col" style="width: 110px;">Prioridad</th>
                    <th scope="col" style="width: 110px;">Estado</th>
                    <th scope="col" style="width: 130px;">Fecha</th>
                    <th scope="col" class="text-end" style="width: 90px;">Acción</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Tickets.Any())
                {
                    @foreach (var item in Model.Tickets)
                    {
                        var asignacion = item.Asignaciones.FirstOrDefault(a => a.Activo);
                        <tr>
                            <td class="font-monospace text-light">@item.Codigo</td>
                            <td>
                                <span class="text-light fw-medium">@item.Titulo</span>
                            </td>
                            <td>
                                @if (item.Equipo != null)
                                {
                                    <span class="text-light small">@item.Equipo.Marca @item.Equipo.Modelo</span>
                                    <div class="text-secondary font-monospace" style="font-size: 0.75rem;">@item.Equipo.CodigoPatrimonial</div>
                                }
                                else
                                {
                                    <span class="text-secondary small">-</span>
                                }
                            </td>
                            <td>
                                <span class="small text-light">@(item.UsuarioSolicitante != null ? $"{item.UsuarioSolicitante.Nombre} {item.UsuarioSolicitante.Apellido} ({item.UsuarioSolicitante.Rol})" : "-")</span>
                            </td>
                            <td>
                                @if (asignacion?.Tecnico != null)
                                {
                                    <span class="small text-light">@asignacion.Tecnico.Nombre @asignacion.Tecnico.Apellido (@asignacion.Tecnico.Rol)</span>
                                }
                                else
                                {
                                    <span class="text-secondary small">Sin asignar</span>
                                }
                            </td>
                            <td>
                                @switch (item.Prioridad)
                                {
                                    case ITManager.Models.Enums.PrioridadTicket.CRITICA:
                                        <span class="badge border border-danger-subtle text-danger">Crítica</span>
                                        break;
                                    case ITManager.Models.Enums.PrioridadTicket.ALTA:
                                        <span class="badge border border-warning-subtle text-warning">Alta</span>
                                        break;
                                    case ITManager.Models.Enums.PrioridadTicket.MEDIA:
                                        <span class="badge border border-secondary text-secondary">Media</span>
                                        break;
                                    case ITManager.Models.Enums.PrioridadTicket.BAJA:
                                        <span class="badge border border-secondary text-secondary">Baja</span>
                                        break;
                                }
                            </td>
                            <td>
                                @switch (item.Estado)
                                {
                                    case ITManager.Models.Enums.EstadoTicket.ABIERTO:
                                        <span class="badge border border-danger-subtle text-danger">Abierto</span>
                                        break;
                                    case ITManager.Models.Enums.EstadoTicket.EN_PROCESO:
                                        <span class="badge border border-warning-subtle text-warning">En proceso</span>
                                        break;
                                    case ITManager.Models.Enums.EstadoTicket.RESUELTO:
                                        <span class="badge border border-success-subtle text-success">Resuelto</span>
                                        break;
                                    case ITManager.Models.Enums.EstadoTicket.CERRADO:
                                        <span class="badge border border-secondary text-secondary">Cerrado</span>
                                        break;
                                }
                            </td>
                            <td class="small text-secondary">
                                @item.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">
                                    Ver
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center py-4 text-secondary small">
                            No se encontraron tickets con los filtros aplicados.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Paginación -->
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-transparent border-top border-secondary-subtle py-3">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <span class="text-secondary small">
                    Página @Model.Page de @Model.TotalPages (Total: @Model.TotalCount)
                </span>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                        <a class="page-link bg-dark border-secondary text-light" asp-action="@(Model.SoloMisTickets ? "MisTickets" : "Index")"
                           asp-route-page="@(Model.Page - 1)"
                           asp-route-estado="@Model.Estado"
                           asp-route-prioridad="@Model.Prioridad">
                            Anterior
                        </a>
                    </li>

                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.Page ? "active" : "")">
                            <a class="page-link @(i == Model.Page ? "bg-light text-dark fw-bold border-light" : "bg-dark border-secondary text-light")"
                               asp-action="@(Model.SoloMisTickets ? "MisTickets" : "Index")"
                               asp-route-page="@i"
                               asp-route-estado="@Model.Estado"
                               asp-route-prioridad="@Model.Prioridad">
                                @i
                            </a>
                        </li>
                    }

                    <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link bg-dark border-secondary text-light" asp-action="@(Model.SoloMisTickets ? "MisTickets" : "Index")"
                           asp-route-page="@(Model.Page + 1)"
                           asp-route-estado="@Model.Estado"
                           asp-route-prioridad="@Model.Prioridad">
                            Siguiente
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    }
</div>
