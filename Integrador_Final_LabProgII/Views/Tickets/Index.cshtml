@model ITManager.ViewModels.TicketIndexViewModel
@{
    ViewData["Title"] = Model.SoloMisTickets ? "Mis Tickets" : "Mesa de Ayuda (Tickets)";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="h3 fw-bold mb-1 text-white">
            <i class="bi bi-ticket-detailed me-2 text-warning"></i>@ViewData["Title"]
        </h2>
        <p class="text-secondary small mb-0">Gestión de incidencias técnicas, seguimiento de SLA y asignaciones.</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-warning text-dark fw-semibold px-3 shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Reportar Incidente
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Filtros -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="@(Model.SoloMisTickets ? "MisTickets" : "Index")" class="row g-2 align-items-center">
            <div class="col-md-4">
                <select name="estado" class="form-select">
                    <option value="">-- Todos los Estados --</option>
                    @foreach (var est in (ITManager.Models.Enums.EstadoTicket[])ViewBag.Estados)
                    {
                        <!option value="@est" @(Model.Estado == est ? "selected" : "")>@est</!option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <select name="prioridad" class="form-select">
                    <option value="">-- Todas las Prioridades --</option>
                    @foreach (var prio in (ITManager.Models.Enums.PrioridadTicket[])ViewBag.Prioridades)
                    {
                        <!option value="@prio" @(Model.Prioridad == prio ? "selected" : "")>@prio</!option>
                    }
                </select>
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-funnel"></i> Filtrar
                </button>
                <a asp-action="@(Model.SoloMisTickets ? "MisTickets" : "Index")" class="btn btn-outline-secondary" title="Limpiar Filtros">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Tabla de Tickets -->
<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark text-secondary">
                <tr>
                    <th scope="col">Código</th>
                    <th scope="col">Incidente</th>
                    <th scope="col">Equipo Afectado</th>
                    <th scope="col">Solicitante</th>
                    <th scope="col">Técnico</th>
                    <th scope="col">Prioridad</th>
                    <th scope="col">Estado</th>
                    <th scope="col">Fecha</th>
                    <th scope="col" class="text-end">Acción</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Tickets.Any())
                {
                    @foreach (var item in Model.Tickets)
                    {
                        var asignacion = item.Asignaciones.FirstOrDefault(a => a.Activo);
                        <tr>
                            <td class="font-monospace fw-bold text-light">@item.Codigo</td>
                            <td>
                                <div class="fw-semibold">@item.Titulo</div>
                            </td>
                            <td>
                                @if (item.Equipo != null)
                                {
                                    <span class="badge bg-dark-subtle text-light border border-secondary-subtle font-monospace">
                                        @item.Equipo.CodigoPatrimonial
                                    </span>
                                    <small class="text-secondary d-block">@item.Equipo.Marca @item.Equipo.Modelo</small>
                                }
                                else
                                {
                                    <span class="text-muted small">No especificado</span>
                                }
                            </td>
                            <td>
                                <span class="small text-light">@(item.UsuarioSolicitante?.Apellido), @(item.UsuarioSolicitante?.Nombre)</span>
                            </td>
                            <td>
                                @if (asignacion?.Tecnico != null)
                                {
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                        <i class="bi bi-person-gear me-1"></i>@(asignacion.Tecnico.Apellido), @(asignacion.Tecnico.Nombre)
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary-emphasis">Sin asignar</span>
                                }
                            </td>
                            <td>
                                @switch (item.Prioridad)
                                {
                                    case ITManager.Models.Enums.PrioridadTicket.CRITICA:
                                        <span class="badge bg-danger">CRÍTICA</span>
                                        break;
                                    case ITManager.Models.Enums.PrioridadTicket.ALTA:
                                        <span class="badge bg-warning text-dark">ALTA</span>
                                        break;
                                    case ITManager.Models.Enums.PrioridadTicket.MEDIA:
                                        <span class="badge bg-info text-dark">MEDIA</span>
                                        break;
                                    case ITManager.Models.Enums.PrioridadTicket.BAJA:
                                        <span class="badge bg-secondary">BAJA</span>
                                        break;
                                }
                            </td>
                            <td>
                                @switch (item.Estado)
                                {
                                    case ITManager.Models.Enums.EstadoTicket.ABIERTO:
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">ABIERTO</span>
                                        break;
                                    case ITManager.Models.Enums.EstadoTicket.EN_PROCESO:
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle">EN PROCESO</span>
                                        break;
                                    case ITManager.Models.Enums.EstadoTicket.RESUELTO:
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">RESUELTO</span>
                                        break;
                                    case ITManager.Models.Enums.EstadoTicket.CERRADO:
                                        <span class="badge bg-secondary-subtle text-secondary-emphasis">CERRADO</span>
                                        break;
                                }
                            </td>
                            <td class="small text-secondary">
                                @item.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="Ver Detalle / Conversación">
                                    <i class="bi bi-chat-left-text me-1"></i> Abrir
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                            No se encontraron tickets con los criterios especificados.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-transparent border-top border-secondary-subtle d-flex justify-content-between align-items-center flex-wrap py-3">
            <span class="text-secondary small">
                Página @Model.Page de @Model.TotalPages (Total: @Model.TotalCount tickets)
            </span>
            <nav aria-label="Navegación de tickets">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="@(Model.SoloMisTickets ? "MisTickets" : "Index")"
                           asp-route-page="@(Model.Page - 1)"
                           asp-route-estado="@Model.Estado"
                           asp-route-prioridad="@Model.Prioridad">Anterior</a>
                    </li>
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(Model.Page == i ? "active" : "")">
                            <a class="page-link" asp-action="@(Model.SoloMisTickets ? "MisTickets" : "Index")"
                               asp-route-page="@i"
                               asp-route-estado="@Model.Estado"
                               asp-route-prioridad="@Model.Prioridad">@i</a>
                        </li>
                    }
                    <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="@(Model.SoloMisTickets ? "MisTickets" : "Index")"
                           asp-route-page="@(Model.Page + 1)"
                           asp-route-estado="@Model.Estado"
                           asp-route-prioridad="@Model.Prioridad">Siguiente</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
