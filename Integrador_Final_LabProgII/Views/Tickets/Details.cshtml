@model ITManager.Models.Ticket
@{
    ViewData["Title"] = $"Ticket {Model.Codigo}";
    var esStaff = User.IsInRole("ADMINISTRADOR") || User.IsInRole("TECNICO");
    var asignacionActiva = Model.Asignaciones.FirstOrDefault(a => a.Activo);
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
            <h1 class="h5 fw-semibold mb-0 text-white">@Model.Titulo</h1>
            <span class="badge border border-secondary text-secondary font-monospace">@Model.Codigo</span>
            @switch (Model.Estado)
            {
                case ITManager.Models.Enums.EstadoTicket.ABIERTO:
                    <span class="badge border border-danger-subtle text-danger">Abierto</span>
                    break;
                case ITManager.Models.Enums.EstadoTicket.EN_PROCESO:
                    <span class="badge border border-warning-subtle text-warning">En proceso</span>
                    break;
                case ITManager.Models.Enums.EstadoTicket.RESUELTO:
                    <span class="badge border border-success-subtle text-success">Resuelto</span>
                    break;
                case ITManager.Models.Enums.EstadoTicket.CERRADO:
                    <span class="badge border border-secondary text-secondary">Cerrado</span>
                    break;
            }
        </div>
        <div class="text-secondary small">
            Solicitante: <span class="text-light">@(Model.UsuarioSolicitante != null ? $"{Model.UsuarioSolicitante.Nombre} {Model.UsuarioSolicitante.Apellido} ({Model.UsuarioSolicitante.Rol})" : "Sin asignar")</span>
            &bull;
            Fecha: @Model.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
        </div>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-4">
    <!-- Columna Izquierda: Información del Incidente, Adjuntos e Hilo de Conversación -->
    <div class="col-lg-8">
        <!-- Detalle de Falla -->
        <div class="card mb-4">
            <div class="card-header">
                <h2 class="h6 fw-semibold mb-0 text-white">Descripción</h2>
            </div>
            <div class="card-body">
                <p class="card-text text-light mb-0" style="white-space: pre-line;">@Model.Descripcion</p>
            </div>
        </div>

        <!-- Archivos Adjuntos -->
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h2 class="h6 fw-semibold mb-0 text-white">Adjuntos (@Model.Adjuntos.Count)</h2>
            </div>
            <div class="card-body">
                @if (Model.Adjuntos.Any())
                {
                    <div class="list-group list-group-flush mb-3">
                        @foreach (var adj in Model.Adjuntos)
                        {
                            <div class="list-group-item bg-transparent text-light px-0 d-flex justify-content-between align-items-center border-bottom border-secondary-subtle">
                                <div>
                                    <a href="@adj.RutaArchivo" target="_blank" class="text-decoration-none text-light fw-medium">
                                        @adj.NombreOriginal
                                    </a>
                                    <div class="text-secondary small">@adj.FechaSubida.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                                </div>
                                <div>
                                    <a asp-controller="Adjuntos" asp-action="Delete" asp-route-id="@adj.Id" class="btn btn-sm btn-outline-danger" onclick="return confirm('¿Confirma eliminar este archivo adjunto?');">
                                        Eliminar
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-secondary small mb-3">Sin archivos adjuntos.</div>
                }

                @if (Model.Estado != ITManager.Models.Enums.EstadoTicket.CERRADO)
                {
                    <form asp-controller="Adjuntos" asp-action="Upload" method="post" enctype="multipart/form-data" class="row g-2 align-items-center">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ticketId" value="@Model.Id" />
                        <div class="col-sm-8">
                            <input type="file" name="archivo" class="form-control" accept=".jpg,.jpeg,.png,.pdf" required />
                        </div>
                        <div class="col-sm-4">
                            <button type="submit" class="btn btn-outline-secondary w-100">
                                Subir Archivo
                            </button>
                        </div>
                    </form>
                }
            </div>
        </div>

        <!-- Hilo de Conversación / Comentarios -->
        <div class="card">
            <div class="card-header">
                <h2 class="h6 fw-semibold mb-0 text-white">Historial de Mensajes (@Model.Comentarios.Count)</h2>
            </div>
            <div class="card-body">
                @if (Model.Comentarios.Any())
                {
                    <div class="d-flex flex-column gap-3 mb-4">
                        @foreach (var c in Model.Comentarios)
                        {
                            <div class="p-3 rounded-2 border border-secondary" style="background-color: #0d0d0d;">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="text-light small fw-medium">
                                        @(c.Usuario != null ? $"{c.Usuario.Nombre} {c.Usuario.Apellido} ({c.Usuario.Rol})" : "Usuario")
                                    </span>
                                    <span class="text-secondary small">@c.FechaHora.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                </div>
                                <div class="text-light" style="white-space: pre-line;">@c.Mensaje</div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-secondary small mb-3">No hay comentarios registrados.</div>
                }

                @if (Model.Estado != ITManager.Models.Enums.EstadoTicket.CERRADO)
                {
                    <form asp-action="AddComentario" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ticketId" value="@Model.Id" />
                        <div class="mb-3">
                            <label for="mensajeComentario" class="form-label small text-secondary">Nuevo Mensaje</label>
                            <textarea id="mensajeComentario" name="mensaje" rows="3" class="form-control" placeholder="Escriba un mensaje..." required></textarea>
                        </div>
                        <div class="text-end">
                            <button type="submit" class="btn btn-primary">
                                Enviar Mensaje
                            </button>
                        </div>
                    </form>
                }
                else
                {
                    <div class="text-secondary small">Ticket cerrado. No se admiten respuestas.</div>
                }
            </div>
        </div>
    </div>

    <!-- Columna Derecha: Equipo Afectado y Gestión Técnica -->
    <div class="col-lg-4">
        <!-- Ficha del Equipo -->
        <div class="card mb-4">
            <div class="card-header">
                <h2 class="h6 fw-semibold mb-0 text-white">Equipo Afectado</h2>
            </div>
            <div class="card-body">
                @if (Model.Equipo != null)
                {
                    <dl class="row mb-0 small">
                        <dt class="col-5 text-secondary">Código</dt>
                        <dd class="col-7 text-light font-monospace">@Model.Equipo.CodigoPatrimonial</dd>

                        <dt class="col-5 text-secondary">Equipo</dt>
                        <dd class="col-7 text-light">@Model.Equipo.Marca @Model.Equipo.Modelo</dd>

                        <dt class="col-5 text-secondary">Categoría</dt>
                        <dd class="col-7 text-light">@(Model.Equipo.Categoria?.Nombre ?? "-")</dd>

                        <dt class="col-5 text-secondary">Ubicación</dt>
                        <dd class="col-7 text-light">@(Model.Equipo.Ubicacion?.Nombre ?? "-")</dd>
                    </dl>
                    <a asp-controller="Equipos" asp-action="Details" asp-route-id="@Model.Equipo.Id" class="btn btn-outline-secondary w-100 mt-3">
                        Ver Ficha del Equipo
                    </a>
                }
            </div>
        </div>

        <!-- Panel de Gestión Técnica -->
        @if (esStaff)
        {
            <div class="card">
                <div class="card-header">
                    <h2 class="h6 fw-semibold mb-0 text-white">Acciones</h2>
                </div>
                <div class="card-body">
                    <!-- Asignación de Técnico -->
                    <form asp-action="AsignarTecnico" method="post" class="mb-4">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ticketId" value="@Model.Id" />
                        <label class="form-label small text-secondary">Asignar Técnico</label>
                        <div class="input-group mb-2">
                            <select name="tecnicoId" asp-items="ViewBag.Tecnicos" class="form-select">
                                <option value="">-- Seleccionar --</option>
                            </select>
                            <button type="submit" class="btn btn-outline-secondary">Asignar</button>
                        </div>
                        @if (asignacionActiva?.Tecnico != null)
                        {
                            <div class="text-secondary small">
                                Actualmente asignado: <strong class="text-light">@asignacionActiva.Tecnico.Nombre @asignacionActiva.Tecnico.Apellido (@asignacionActiva.Tecnico.Rol)</strong>
                            </div>
                        }
                    </form>

                    <!-- Cambio de Estado -->
                    <form asp-action="CambiarEstado" method="post" class="mb-4">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ticketId" value="@Model.Id" />
                        <label class="form-label small text-secondary">Estado del Ticket</label>
                        <div class="input-group">
                            <select name="nuevoEstado" class="form-select">
                                @foreach (var est in (ITManager.Models.Enums.EstadoTicket[])ViewBag.Estados)
                                {
                                    <!option value="@est" @(Model.Estado == est ? "selected" : "")>@est</!option>
                                }
                            </select>
                            <button type="submit" class="btn btn-outline-secondary">Guardar</button>
                        </div>
                    </form>

                    <!-- Generar Orden de Mantenimiento -->
                    <div class="border-top border-secondary-subtle pt-3">
                        <a href="/Mantenimientos/Create?ticketId=@Model.Id&equipoId=@Model.EquipoId" class="btn btn-primary w-100">
                            Iniciar Mantenimiento
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
