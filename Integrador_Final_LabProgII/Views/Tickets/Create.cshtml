@model ITManager.ViewModels.TicketCreateViewModel
@{
    ViewData["Title"] = "Reportar Incidente";
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <div class="card border-0 shadow-lg">
            <div class="card-header bg-dark-subtle py-3 border-0">
                <div class="d-flex align-items-center justify-content-between">
                    <h4 class="h5 fw-bold mb-0 text-white">
                        <i class="bi bi-exclamation-octagon me-2 text-warning"></i>
                        Nuevo Incidente Técnico
                    </h4>
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Volver
                    </a>
                </div>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-4" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="EquipoId" class="form-label fw-semibold small text-light"></label>
                        <select asp-for="EquipoId" asp-items="ViewBag.Equipos" class="form-select">
                            <option value="">-- Seleccionar Equipo Afectado --</option>
                        </select>
                        <span asp-validation-for="EquipoId" class="text-danger small"></span>
                        <div class="form-text text-secondary small">Seleccione el equipo que presenta la avería o solicitud de soporte.</div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Titulo" class="form-label fw-semibold small text-light"></label>
                        <input asp-for="Titulo" class="form-control" placeholder="Ej: No enciende el equipo / Falla disco duro / Pantalla azul" />
                        <span asp-validation-for="Titulo" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Prioridad" class="form-label fw-semibold small text-light"></label>
                        <select asp-for="Prioridad" class="form-select">
                            @foreach (var prio in (ITManager.Models.Enums.PrioridadTicket[])ViewBag.Prioridades)
                            {
                                <option value="@prio">@prio</option>
                            }
                        </select>
                        <span asp-validation-for="Prioridad" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Descripcion" class="form-label fw-semibold small text-light"></label>
                        <textarea asp-for="Descripcion" rows="5" class="form-control" placeholder="Detalle los síntomas del problema, mensajes de error o acciones previas a la falla..."></textarea>
                        <span asp-validation-for="Descripcion" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-3 border-top border-secondary-subtle">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancelar</a>
                        <button type="submit" class="btn btn-warning text-dark px-4 fw-semibold">
                            <i class="bi bi-send me-1"></i> Enviar Incidente
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

