@model ITManager.ViewModels.TicketCreateViewModel
@{
    ViewData["Title"] = "Reportar Incidente";
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <div class="card">
            <div class="card-header d-flex align-items-center justify-content-between">
                <h1 class="h6 fw-semibold mb-0 text-white">Nuevo Ticket</h1>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Volver</a>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-4" role="alert"></div>

                    <!-- Búsqueda Asíncrona de Equipo (AJAX) -->
                    <div class="mb-3 position-relative">
                        <label class="form-label small text-secondary">Equipo Afectado *</label>
                        <input type="hidden" asp-for="EquipoId" id="equipoIdInput" />
                        
                        <div class="input-group">
                            <input type="text" id="equipoSearchInput" class="form-control" 
                                   placeholder="Buscar por código, modelo, serie..." autocomplete="off" />
                            <button type="button" class="btn btn-outline-secondary" id="btnLimpiarEquipo" style="display: none;">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                        <span asp-validation-for="EquipoId" class="text-danger small d-block mt-1"></span>

                        <!-- Dropdown de resultados asíncronos -->
                        <div id="equipoResultsDropdown" class="list-group position-absolute w-100 shadow-lg" 
                             style="display: none; z-index: 1050; max-height: 250px; overflow-y: auto;">
                        </div>

                        <!-- Card de Equipo Seleccionado -->
                        <div id="equipoSeleccionadoCard" class="card mt-2 p-2" style="display: none;">
                            <div class="d-flex align-items-center justify-content-between">
                                <div>
                                    <span class="badge border border-secondary text-secondary me-2" id="selCodigo"></span>
                                    <span class="text-light small fw-medium" id="selDetalle"></span>
                                </div>
                                <span class="badge bg-secondary" id="selEstado"></span>
                            </div>
                        </div>
                    </div>
                                    <strong class="text-light" id="selDetalle"></strong>
                                </div>
                                <span class="badge bg-secondary" id="selEstado"></span>
                            </div>
                        </div>

                        <div class="form-text text-secondary small">
                            La búsqueda consulta el servidor de manera asíncrona sin cargar todos los registros en el cliente.
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Titulo" class="form-label fw-semibold small text-light"></label>
                        <input asp-for="Titulo" class="form-control" placeholder="Ej: No enciende el equipo / Falla disco duro / Pantalla azul" />
                        <span asp-validation-for="Titulo" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Prioridad" class="form-label fw-semibold small text-light"></label>
                        <select asp-for="Prioridad" class="form-select">
                            @foreach (var prio in (ITManager.Models.Enums.PrioridadTicket[])ViewBag.Prioridades)
                            {
                                <option value="@prio">@prio</option>
                            }
                        </select>
                        <span asp-validation-for="Prioridad" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Descripcion" class="form-label fw-semibold small text-light"></label>
                        <textarea asp-for="Descripcion" rows="4" class="form-control" placeholder="Detalle los síntomas del problema, mensajes de error o acciones previas a la falla..."></textarea>
                        <span asp-validation-for="Descripcion" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ArchivoAdjunto" class="form-label fw-semibold small text-light"></label>
                        <input type="file" asp-for="ArchivoAdjunto" class="form-control" accept=".jpg,.jpeg,.png,.pdf" />
                        <span asp-validation-for="ArchivoAdjunto" class="text-danger small"></span>
                        <div class="form-text text-secondary small">Opcional: Captura de pantalla, foto o reporte (.jpg, .png, .pdf, máx. 5 MB).</div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-3 border-top border-secondary-subtle">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancelar</a>
                        <button type="submit" class="btn btn-warning text-dark px-4 fw-semibold">
                            <i class="bi bi-send me-1"></i> Enviar Incidente
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('equipoSearchInput');
            const equipoIdInput = document.getElementById('equipoIdInput');
            const resultsDropdown = document.getElementById('equipoResultsDropdown');
            const btnLimpiar = document.getElementById('btnLimpiarEquipo');
            const cardSeleccionado = document.getElementById('equipoSeleccionadoCard');
            const selCodigo = document.getElementById('selCodigo');
            const selDetalle = document.getElementById('selDetalle');
            const selEstado = document.getElementById('selEstado');

            let debounceTimer;

            searchInput.addEventListener('input', function () {
                clearTimeout(debounceTimer);
                const term = searchInput.value.trim();

                if (term.length < 1) {
                    resultsDropdown.style.display = 'none';
                    resultsDropdown.innerHTML = '';
                    return;
                }

                debounceTimer = setTimeout(() => {
                    fetch(`/Equipos/Search?term=${encodeURIComponent(term)}`)
                        .then(res => res.json())
                        .then(items => {
                            resultsDropdown.innerHTML = '';
                            if (!items || items.length === 0) {
                                resultsDropdown.innerHTML = `
                                    <div class="list-group-item bg-dark text-secondary small">
                                        No se encontraron equipos para "${term}".
                                    </div>`;
                            } else {
                                items.forEach(eq => {
                                    const btn = document.createElement('button');
                                    btn.type = 'button';
                                    btn.className = 'list-group-item list-group-item-action bg-dark text-white border-secondary d-flex justify-content-between align-items-center py-2';
                                    btn.innerHTML = `
                                        <div>
                                            <strong class="text-info">${eq.codigo}</strong> - ${eq.marca} ${eq.modelo}
                                            <div class="small text-secondary">Serie: ${eq.numeroSerie}</div>
                                        </div>
                                        <span class="badge bg-secondary-subtle text-secondary-emphasis">${eq.estado}</span>
                                    `;
                                    btn.addEventListener('click', () => {
                                        seleccionarEquipo(eq);
                                    });
                                    resultsDropdown.appendChild(btn);
                                });
                            }
                            resultsDropdown.style.display = 'block';
                        })
                        .catch(() => {
                            resultsDropdown.style.display = 'none';
                        });
                }, 250);
            });

            function seleccionarEquipo(eq) {
                equipoIdInput.value = eq.id;
                searchInput.value = `${eq.codigo} - ${eq.marca} ${eq.modelo}`;
                searchInput.disabled = true;
                resultsDropdown.style.display = 'none';
                btnLimpiar.style.display = 'inline-block';

                selCodigo.textContent = eq.codigo;
                selDetalle.textContent = `${eq.marca} ${eq.modelo} (S/N: ${eq.numeroSerie})`;
                selEstado.textContent = eq.estado;
                cardSeleccionado.style.display = 'block';
            }

            btnLimpiar.addEventListener('click', function () {
                equipoIdInput.value = '';
                searchInput.value = '';
                searchInput.disabled = false;
                searchInput.focus();
                btnLimpiar.style.display = 'none';
                cardSeleccionado.style.display = 'none';
                resultsDropdown.style.display = 'none';
            });

            // Cerrar dropdown al hacer click afuera
            document.addEventListener('click', function (e) {
                if (!searchInput.contains(e.target) && !resultsDropdown.contains(e.target)) {
                    resultsDropdown.style.display = 'none';
                }
            });
        });
    </script>
}
