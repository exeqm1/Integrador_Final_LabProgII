@model ITManager.ViewModels.UsuarioCreateViewModel
@{
    ViewData["Title"] = "Nuevo Usuario";
}

<div class="row justify-content-center">
    <div class="col-lg-7 col-xl-6">
        <div class="card border-0 shadow-lg">
            <div class="card-header bg-dark-subtle py-3 border-0">
                <div class="d-flex align-items-center justify-content-between">
                    <h4 class="h5 fw-bold mb-0 text-white">
                        <i class="bi bi-person-plus me-2 text-primary"></i>
                        Nuevo Usuario
                    </h4>
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Volver
                    </a>
                </div>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-4"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Nombre" class="form-label small fw-semibold text-light"></label>
                            <input asp-for="Nombre" class="form-control" />
                            <span asp-validation-for="Nombre" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Apellido" class="form-label small fw-semibold text-light"></label>
                            <input asp-for="Apellido" class="form-control" />
                            <span asp-validation-for="Apellido" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Email" class="form-label small fw-semibold text-light"></label>
                            <input asp-for="Email" class="form-control" placeholder="usuario@itmanager.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Password" class="form-label small fw-semibold text-light"></label>
                            <input asp-for="Password" class="form-control" placeholder="Contraseña de acceso inicial" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Rol" class="form-label small fw-semibold text-light"></label>
                            <select asp-for="Rol" class="form-select">
                                @foreach (var r in (ITManager.Models.Enums.RolUsuario[])ViewBag.Roles)
                                {
                                    <option value="@r">@r</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="UbicacionId" class="form-label small fw-semibold text-light"></label>
                            <select asp-for="UbicacionId" asp-items="ViewBag.Ubicaciones" class="form-select">
                                <option value="">-- Seleccionar Ubicación --</option>
                            </select>
                            <span asp-validation-for="UbicacionId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top border-secondary-subtle">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancelar</a>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold">
                            <i class="bi bi-save me-1"></i> Guardar Usuario
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

