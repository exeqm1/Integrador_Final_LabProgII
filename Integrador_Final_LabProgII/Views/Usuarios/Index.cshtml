@model IEnumerable<ITManager.Models.Usuario>
@{
    ViewData["Title"] = "Usuarios del Sistema";
    var ubicaciones = (Dictionary<int, string>)ViewBag.UbicacionesMap;
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="h3 fw-bold mb-1 text-white">
            <i class="bi bi-people me-2 text-primary"></i>Usuarios y Roles del Sistema
        </h2>
        <p class="text-secondary small mb-0">Administración de cuentas de acceso, asignación de roles y estados operativos.</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary px-3 shadow-sm fw-semibold">
            <i class="bi bi-person-plus me-1"></i> Nuevo Usuario
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark text-secondary">
                <tr>
                    <th>Usuario</th>
                    <th>Correo Electrónico</th>
                    <th>Rol</th>
                    <th>Ubicación</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var u in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 32px; height: 32px; font-size: 0.8rem;">
                                        @u.Nombre[..1]@u.Apellido[..1]
                                    </div>
                                    <div>
                                        <div class="fw-semibold text-light">@u.Apellido, @u.Nombre</div>
                                    </div>
                                </div>
                            </td>
                            <td class="font-monospace small">@u.Email</td>
                            <td>
                                @switch (u.Rol)
                                {
                                    case ITManager.Models.Enums.RolUsuario.ADMINISTRADOR:
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">ADMINISTRADOR</span>
                                        break;
                                    case ITManager.Models.Enums.RolUsuario.TECNICO:
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle">TÉCNICO</span>
                                        break;
                                    case ITManager.Models.Enums.RolUsuario.EMPLEADO:
                                        <span class="badge bg-secondary-subtle text-secondary-emphasis">EMPLEADO</span>
                                        break;
                                }
                            </td>
                            <td class="small">
                                <i class="bi bi-geo-alt text-secondary me-1"></i>
                                @(ubicaciones.ContainsKey(u.UbicacionId) ? ubicaciones[u.UbicacionId] : "Sin asignar")
                            </td>
                            <td>
                                @if (u.Activo)
                                {
                                    <span class="badge bg-success-subtle text-success">ACTIVO</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger">INACTIVO</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1">
                                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#modalPassword_@u.Id" title="Resetear Contraseña">
                                        <i class="bi bi-key"></i>
                                    </button>
                                    <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-sm btn-outline-warning" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                </div>

                                <!-- Modal Reset Contraseña -->
                                <div class="modal fade" id="modalPassword_@u.Id" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered modal-sm text-start">
                                        <div class="modal-content bg-dark border-secondary">
                                            <form asp-action="ResetPassword" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@u.Id" />
                                                <div class="modal-header border-secondary py-2">
                                                    <h6 class="modal-title text-white">Resetear Clave: @u.Email</h6>
                                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body py-3">
                                                    <label class="form-label small text-secondary">Nueva Contraseña:</label>
                                                    <input type="password" name="nuevaPassword" class="form-control" placeholder="Mínimo 6 caracteres" minlength="6" required />
                                                </div>
                                                <div class="modal-footer border-secondary py-2">
                                                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                                                    <button type="submit" class="btn btn-sm btn-primary">Guardar Clave</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">
                            No hay usuarios dados de alta.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
