@model IEnumerable<ITManager.Models.Ubicacion>
@{
    ViewData["Title"] = "Ubicaciones y Sedes";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="h3 fw-bold mb-1 text-white">
            <i class="bi bi-geo-alt me-2 text-primary"></i>Sedes y Ubicaciones Físicas
        </h2>
        <p class="text-secondary small mb-0">Gestión de edificios, campus y oficinas donde residen activos y personal.</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary px-3 shadow-sm fw-semibold">
            <i class="bi bi-plus-circle me-1"></i> Nueva Ubicación
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark text-secondary">
                <tr>
                    <th>Sede / Lugar</th>
                    <th>Edificio</th>
                    <th>Piso / Oficina</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var u in Model)
                    {
                        <tr>
                            <td class="fw-bold text-light">@u.Nombre</td>
                            <td>@u.Edificio</td>
                            <td class="text-secondary">@u.PisoOficina</td>
                            <td>
                                @if (u.Activo)
                                {
                                    <span class="badge bg-success-subtle text-success">HABILITADA</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary-emphasis">DESHABILITADA</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1">
                                    <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-sm btn-outline-warning" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@u.Id" method="post" class="d-inline" onsubmit="return confirm('¿Confirma eliminar @u.Nombre?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="5" class="text-center py-4 text-muted">No hay ubicaciones registradas.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

