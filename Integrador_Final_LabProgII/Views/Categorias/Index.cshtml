@{
    ViewData["Title"] = "Categorías de Hardware (SPA Vue.js)";
}

<div id="vue-categorias-app" v-cloak>
    <!-- Encabezado -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="h3 fw-bold mb-1 text-white">
                <i class="bi bi-tags me-2 text-primary"></i>Gestión de Categorías
                <span class="badge bg-success-subtle text-success border border-success-subtle fs-6 ms-2">
                    <i class="bi bi-lightning-charge me-1"></i>SPA Reactivo con Vue.js
                </span>
            </h2>
            <p class="text-secondary small mb-0">ABM completo y reactivo ejecutado vía AJAX / JSON sin recargar la página.</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-primary px-3 shadow-sm fw-semibold" @@click="abrirModalCrear">
                <i class="bi bi-plus-circle me-1"></i> Nueva Categoría
            </button>
            <button class="btn btn-outline-secondary btn-sm" @@click="cargarCategorias" :disabled="cargando" title="Refrescar datos">
                <i class="bi bi-arrow-clockwise" :class="{ 'spin-anim': cargando }"></i>
            </button>
        </div>
    </div>

    <!-- Alertas reactivas -->
    <div v-if="mensajeExito" class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> {{ mensajeExito }}
        <button type="button" class="btn-close" @@click="mensajeExito = ''"></button>
    </div>

    <div v-if="mensajeError" class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> {{ mensajeError }}
        <button type="button" class="btn-close" @@click="mensajeError = ''"></button>
    </div>

    <!-- Buscador Reactivo y Contador -->
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body p-3">
            <div class="row g-2 align-items-center">
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text bg-dark-subtle border-secondary text-secondary">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" v-model="filtro" class="form-control" placeholder="Filtrar por nombre o descripción en tiempo real..." />
                        <button v-if="filtro" class="btn btn-outline-secondary" @@click="filtro = ''">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>
                </div>
                <div class="col-md-6 text-md-end text-secondary small">
                    Mostrando <strong>{{ categoriasFiltradas.length }}</strong> de <strong>{{ categorias.length }}</strong> categorías
                </div>
            </div>
        </div>
    </div>

    <!-- Tabla Reactiva -->
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark text-secondary">
                    <tr>
                        <th style="width: 100px;"># ID</th>
                        <th style="width: 280px;">Categoría</th>
                        <th>Descripción</th>
                        <th class="text-end" style="width: 160px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <tr v-if="cargando">
                        <td colspan="4" class="text-center py-5 text-secondary">
                            <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                            Cargando categorías vía AJAX...
                        </td>
                    </tr>
                    <tr v-else-if="categoriasFiltradas.length === 0">
                        <td colspan="4" class="text-center py-5 text-secondary">
                            <i class="bi bi-inbox fs-2 d-block mb-2 text-muted"></i>
                            No se encontraron categorías que coincidan con la búsqueda.
                        </td>
                    </tr>
                    <tr v-else v-for="cat in categoriasFiltradas" :key="cat.id">
                        <td class="font-monospace text-secondary">#{{ cat.id }}</td>
                        <td class="fw-bold text-light">
                            <i class="bi bi-tag-fill text-primary me-2"></i>{{ cat.nombre }}
                        </td>
                        <td class="text-secondary small">
                            {{ cat.descripcion || 'Sin descripción registrada.' }}
                        </td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <button class="btn btn-outline-warning" @@click="abrirModalEditar(cat)" title="Editar categoría">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button class="btn btn-outline-danger" @@click="confirmarEliminar(cat)" title="Eliminar categoría">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Modal Formulario Reactivo (Crear / Editar) -->
    <div class="modal fade" id="modalCategoria" tabindex="-1" aria-hidden="true" ref="modalElement">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-dark border border-secondary shadow-lg">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title text-white">
                        <i :class="modoEdicion ? 'bi bi-pencil-square text-warning' : 'bi bi-plus-circle text-primary'" class="me-2"></i>
                        {{ modoEdicion ? 'Modificar Categoría' : 'Nueva Categoría' }}
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form @@submit.prevent="guardarCategoria">
                    <div class="modal-body">
                        <div v-if="errorFormulario" class="alert alert-danger py-2 small mb-3">
                            <i class="bi bi-exclamation-circle me-1"></i> {{ errorFormulario }}
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold small text-light">Nombre de la Categoría *</label>
                            <input type="text" v-model="form.nombre" class="form-control" placeholder="Ej: Notebooks, Servidores, Impresoras" required ref="inputNombre" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold small text-light">Descripción</label>
                            <textarea v-model="form.descripcion" class="form-control" rows="3" placeholder="Detalles de los equipos comprendidos en este grupo..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer border-secondary">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary px-3" :disabled="guardando">
                            <span v-if="guardando" class="spinner-border spinner-border-sm me-1" role="status"></span>
                            <i v-else class="bi bi-save me-1"></i>
                            {{ modoEdicion ? 'Actualizar' : 'Guardar' }}
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    [v-cloak] { display: none; }
    .spin-anim { animation: spin 1s linear infinite; }
    @@keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
</style>

@section Scripts {
    <!-- Vue.js 3 via CDN -->
    <script src="https://unpkg.com/vue@3/dist/vue.global.prod.js"></script>

    <script>
        const { createApp } = Vue;

        createApp({
            data() {
                return {
                    categorias: [],
                    cargando: false,
                    guardando: false,
                    filtro: '',
                    mensajeExito: '',
                    mensajeError: '',
                    errorFormulario: '',
                    modoEdicion: false,
                    modalInstance: null,
                    form: {
                        id: 0,
                        nombre: '',
                        descripcion: ''
                    }
                };
            },
            computed: {
                categoriasFiltradas() {
                    if (!this.filtro.trim()) return this.categorias;
                    const f = this.filtro.toLowerCase();
                    return this.categorias.filter(c =>
                        (c.nombre && c.nombre.toLowerCase().includes(f)) ||
                        (c.descripcion && c.descripcion.toLowerCase().includes(f))
                    );
                }
            },
            mounted() {
                this.modalInstance = new bootstrap.Modal(this.$refs.modalElement);
                this.cargarCategorias();
            },
            methods: {
                async cargarCategorias() {
                    this.cargando = true;
                    this.mensajeError = '';
                    try {
                        const res = await fetch('/Categorias/GetAllJson');
                        const data = await res.json();
                        if (data.success) {
                            this.categorias = data.data;
                        } else {
                            this.mensajeError = data.message || 'Error al obtener categorías.';
                        }
                    } catch (err) {
                        this.mensajeError = 'Error de conexión con el servidor.';
                    } finally {
                        this.cargando = false;
                    }
                },
                abrirModalCrear() {
                    this.modoEdicion = false;
                    this.errorFormulario = '';
                    this.form = { id: 0, nombre: '', descripcion: '' };
                    this.modalInstance.show();
                    this.$nextTick(() => {
                        this.$refs.inputNombre?.focus();
                    });
                },
                abrirModalEditar(cat) {
                    this.modoEdicion = true;
                    this.errorFormulario = '';
                    this.form = { id: cat.id, nombre: cat.nombre, descripcion: cat.descripcion };
                    this.modalInstance.show();
                    this.$nextTick(() => {
                        this.$refs.inputNombre?.focus();
                    });
                },
                async guardarCategoria() {
                    if (!this.form.nombre.trim()) {
                        this.errorFormulario = 'El nombre de la categoría es requerido.';
                        return;
                    }

                    this.guardando = true;
                    this.errorFormulario = '';

                    const url = this.modoEdicion
                        ? `/Categorias/UpdateJson/${this.form.id}`
                        : '/Categorias/CreateJson';
                    const method = this.modoEdicion ? 'PUT' : 'POST';

                    try {
                        const res = await fetch(url, {
                            method: method,
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({
                                id: this.form.id,
                                nombre: this.form.nombre,
                                descripcion: this.form.descripcion
                            })
                        });

                        const data = await res.json();
                        if (data.success) {
                            this.modalInstance.hide();
                            this.mensajeExito = data.message;
                            await this.cargarCategorias();
                            setTimeout(() => { this.mensajeExito = ''; }, 4000);
                        } else {
                            this.errorFormulario = data.message || 'Error al guardar.';
                        }
                    } catch (err) {
                        this.errorFormulario = 'Error de comunicación al guardar.';
                    } finally {
                        this.guardando = false;
                    }
                },
                async confirmarEliminar(cat) {
                    if (!confirm(`¿Está seguro de eliminar la categoría "${cat.nombre}"?`)) return;

                    this.cargando = true;
                    this.mensajeError = '';
                    this.mensajeExito = '';

                    try {
                        const res = await fetch(`/Categorias/DeleteJson/${cat.id}`, {
                            method: 'DELETE'
                        });
                        const data = await res.json();
                        if (data.success) {
                            this.mensajeExito = data.message;
                            await this.cargarCategorias();
                            setTimeout(() => { this.mensajeExito = ''; }, 4000);
                        } else {
                            this.mensajeError = data.message;
                        }
                    } catch (err) {
                        this.mensajeError = 'Error de conexión al eliminar.';
                    } finally {
                        this.cargando = false;
                    }
                }
            }
        }).mount('#vue-categorias-app');
    </script>
}
